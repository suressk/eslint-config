{
  "name": "@suressk/eslint-config",
  "version": "1.0.8",
  "description": "K.'s preset ESLint configuration",
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -Rf dist && vite build",
    "prepare": "pnpm run build",
    "dev": "vite build --watch",
    "lint": "eslint --config eslint.config.ts .",
    "lint:fix": "eslint --config eslint.config.ts . --fix",
    "test": "eslint --config eslint.config.ts ."
  },
  "keywords": [
    "eslint",
    "eslintconfig",
    "preset",
    "typescript"
  ],
  "author": {
    "name": "suressk",
    "email": "suresskun@outlook.com"
  },
  "homepage": "https://github.com/suressk/eslint-config",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suressk/eslint-config.git"
  },
  "bugs": {
    "url": "https://github.com/suressk/eslint-config/issues"
  },
  "license": "MIT",
  "peerDependencies": {
    "eslint": ">=10.0.0"
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.1",
    "@eslint/markdown": "^8.0.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitest/eslint-plugin": "^1.6.17",
    "astro-eslint-parser": "^1.4.0",
    "eslint-config-flat-gitignore": "^2.0.0",
    "eslint-flat-config-utils": "^3.2.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-import-lite": "^0.6.0",
    "eslint-plugin-jsdoc": "^63.0.0",
    "eslint-plugin-jsonc": "^3.1.2",
    "eslint-plugin-n": "^18.0.1",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-regexp": "^2.0.0",
    "eslint-plugin-svelte": "^3.17.1",
    "eslint-plugin-toml": "^1.3.1",
    "eslint-plugin-unicorn": "^64.0.0",
    "eslint-plugin-unused-imports": "^4.0.0",
    "eslint-plugin-vue": "^10.9.1",
    "eslint-plugin-yml": "^3.3.2",
    "local-pkg": "^1.1.2",
    "svelte-eslint-parser": "^1.6.1",
    "toml-eslint-parser": "^1.0.3",
    "vue-eslint-parser": "^10.4.0",
    "yaml-eslint-parser": "^2.0.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.7",
    "@types/fs-extra": "^11.0.4",
    "@types/minimist": "^1.2.5",
    "@types/node": "^20.0.0",
    "@types/prompts": "^2.4.9",
    "@types/semver": "^7.7.1",
    "eslint": "^10.0.0",
    "execa": "^9.6.1",
    "fs-extra": "^11.3.5",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.0.4",
    "minimist": "^1.2.8",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "semver": "^7.8.0",
    "typescript": "^5.0.0",
    "vite": "^8.0.13",
    "vite-plugin-dts": "^5.0.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*": "eslint --config eslint.config.ts ."
  }
}
